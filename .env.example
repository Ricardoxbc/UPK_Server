# Puerto interno del servicio (EasyPanel: el mismo que se configure como puerto del proxy)
PORT=3000

# MongoDB existente. En EasyPanel usar el host interno del servicio de Mongo, por ejemplo:
# mongodb://upk_server:CLAVE@proyecto_mongo:27017/upk_server?authSource=upk_server
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=upk_server

# Secreto de la cookie de sesión del panel (mínimo 32 caracteres aleatorios):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Contenido de update_public_key.b64 del Launcher (src/main/resources). NUNCA la clave privada.
PUBLIC_KEY_B64=

# Carpeta de los jar (en EasyPanel: volumen montado en /data)
DATA_DIR=/data

# URL externa del servicio (la https que da EasyPanel), sin barra final
BASE_URL=https://upk-server.xxxx.easypanel.host

# Administrador inicial: se crea solo si no hay ninguno. Quitar ADMIN_PASSWORD después del primer arranque.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Opcional: si se define, cada Launcher cambia su update.api.url a esta (migrar de dominio)
# NEW_API_URL=https://upd.midominio.com/api/v1/update

# Opcional: zona horaria de las fechas del panel
# TIMEZONE=America/Lima

# Solo desarrollo local por http: SECURE_COOKIE=false

# Opcional: URL de la demo web (botones "Probar la demo" de la presentación y el manual)
# DEMO_URL=https://upk-demo.vercel.app
